{
  "name": "@fyuuki0jp/ts2lean",
  "version": "0.1.1",
  "description": "Verify TypeScript functions and transactional ledger services against Lean 4 contracts",
  "type": "module",
  "bin": {
    "ts2lean": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "lean",
    "lean-toolchain",
    "README.md",
    "LICENSE",
    "docs/semantics.md",
    "docs/differential-testing.md",
    "docs/github-packages.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.json && node scripts/bundle.mjs && node scripts/link-self.mjs",
    "test": "npm run build && npm run test:types && node --test --test-concurrency=1 test/*.test.mjs",
    "verify:example": "vitest run --config examples/balance/vitest.config.ts",
    "prepack": "npm run build",
    "test:types": "node node_modules/typescript/bin/tsc -p test/tsconfig.json",
    "verify:payments": "vitest run --config examples/payments/vitest.config.ts",
    "test:payments": "npm run build && node --test --test-concurrency=1 test/completion.test.mjs test/payments.test.mjs && npm run verify:payments",
    "typecheck:payments": "tsc -p examples/payments/tsconfig.json --runExternalCode",
    "test:semantics": "npm run test:differential && node --test test/completion.test.mjs",
    "verify:architectures": "vitest run --config examples/architectures/vitest.config.ts",
    "test:architectures": "npm run build && node --test test/architecture.test.mjs && npm run verify:architectures",
    "typecheck:architectures": "tsc -p examples/architectures/tsconfig.json --runExternalCode",
    "test:differential": "npm run build && node scripts/differential.mjs && node scripts/differential-effects.mjs",
    "verify:inventory": "vitest run --config examples/inventory/vitest.config.ts",
    "typecheck:inventory": "tsc -p examples/inventory/tsconfig.json --runExternalCode",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "dev:payments": "node scripts/payments-demo.mjs",
    "build:payments-ui": "vite build --config examples/payments/ui/vite.config.ts",
    "verify:payments-ui": "vitest run --config examples/payments/ui/vitest.config.ts",
    "typecheck:payments-ui": "node scripts/link-self.mjs && tsc -p examples/payments/ui/tsconfig.json --runExternalCode"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "dist/mapper.js"
      ],
      "dynamicConfig": true
    }
  },
  "dependencies": {
    "typescript": "7.1.0-beta"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "magic-string": "0.30.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rolldown": "1.2.15",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "peerDependencies": {
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyuuki0jp/ts2lean.git"
  },
  "homepage": "https://github.com/fyuuki0jp/ts2lean#readme",
  "bugs": {
    "url": "https://github.com/fyuuki0jp/ts2lean/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
