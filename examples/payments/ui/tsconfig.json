{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node", "react", "react-dom"]
  },
  "contentMappers": [{ "package": "@fyuuki0jp/ts2lean", "extensions": [".lean"] }],
  "include": ["*.ts", "*.tsx"]
}
